[Unit]
Description=pxczxn Alertmanager to Feishu relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pxczxn
Group=pxczxn
EnvironmentFile=/etc/pxczxn/alertmanager-feishu.env
ExecStart=/usr/bin/python3 /usr/local/lib/pxczxn/ops/alertmanager-feishu-relay.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
