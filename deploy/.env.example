# Copy to deploy/.env and replace every REPLACE_WITH value before deployment.
APP_DOMAIN=community.example.com
ADMIN_DOMAIN=admin.community.example.com
COMPOSE_PROJECT_NAME=pxczxn

MYSQL_DATABASE=pxczxn_community
MYSQL_USER=pxczxn
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=pxczxn-minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MINIO_PASSWORD

PXCZXN_CORS_ALLOWED_ORIGINS=https://community.example.com,https://admin.community.example.com
PXCZXN_LOCAL_ADMIN_USERNAME=REPLACE_WITH_INITIAL_ADMIN_USERNAME
PXCZXN_LOCAL_ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
PXCZXN_COMMUNITY_VERSION=1.0.0
PXCZXN_CANARY_REGISTRATION_ENABLED=true
# Use a positive value during invitation-only rollout; set 0 only for formal public opening.
PXCZXN_CANARY_MAX_REGISTERED_USERS=100

# Keep backups outside the repository and all Docker volumes.
BACKUP_DIR=/srv/pxczxn-backups
BACKUP_RETENTION_DAYS=14

# Copy deploy/monitoring/alertmanager.yml.example to alertmanager.yml and set the receiver.
