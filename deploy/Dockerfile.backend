FROM node:22.13-bookworm-slim AS admin-build
WORKDIR /workspace
COPY pxczxn-admin/package.json pxczxn-admin/package-lock.json ./pxczxn-admin/
RUN npm --prefix pxczxn-admin ci --no-audit --no-fund
COPY pxczxn-admin ./pxczxn-admin
COPY pxczxn-backend/pxczxn-starter/src/main/resources ./pxczxn-backend/pxczxn-starter/src/main/resources
RUN npm --prefix pxczxn-admin run build

FROM maven:3.9.11-eclipse-temurin-21 AS backend-build
WORKDIR /workspace/pxczxn-backend
COPY pxczxn-backend .
COPY --from=admin-build /workspace/pxczxn-backend/pxczxn-starter/src/main/resources/static ./pxczxn-starter/src/main/resources/static
RUN mvn -B -ntp -pl pxczxn-starter -am package -DskipTests

FROM eclipse-temurin:21-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend-build /workspace/pxczxn-backend/pxczxn-starter/target/pxczxn-starter-1.0.0.jar app.jar
EXPOSE 8849
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD curl --fail --silent http://127.0.0.1:8849/api/v1/health || exit 1
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
