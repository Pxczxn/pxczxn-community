map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream pxczxn_backend { server backend:8849; }
upstream pxczxn_web { server web:8847; }

server {
    listen 80;
    server_name ${APP_DOMAIN} ${ADMIN_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    location ~ ^/(api/v1|admin-api)/ { proxy_pass http://pxczxn_backend; include /etc/nginx/snippets/proxy.conf; }
    location /ws/ { proxy_pass http://pxczxn_backend; include /etc/nginx/snippets/proxy.conf; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; }
    location / { proxy_pass http://pxczxn_web; include /etc/nginx/snippets/proxy.conf; }
}

server {
    listen 443 ssl http2;
    server_name ${ADMIN_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    location / { proxy_pass http://pxczxn_backend; include /etc/nginx/snippets/proxy.conf; }
}
